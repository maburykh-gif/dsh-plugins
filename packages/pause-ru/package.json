{
  "name": "@dsh-plugins/pause-ru",
  "version": "0.1.8-ru.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "description": "Русский форк dsh-pause: пауза перед следующим шагом агента, чтобы успеть вклиниться в ответ; кнопка в composer и строка «Приостановлено · Enter или клик — продолжить» на русском языке",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pause",
    "gate",
    "steer",
    "tool-round",
    "russian",
    "localization",
    "fork"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maburykh-gif/dsh-plugins.git",
    "directory": "packages/pause-ru"
  },
  "author": "betterer <upstream dsh-pause>; русская локализация — maburykh-gif",
  "engines": {
    "node": ">=26.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "react": "^18.2.0"
  }
}
